# Copy to .env.local and fill in. All of these must also exist in Vercel.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time - never
# put a secret behind that prefix.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ImageKit - URL generation only (no uploads), so no private key is needed.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# Resend - server-side only, keep unprefixed
RESEND_API_KEY=
